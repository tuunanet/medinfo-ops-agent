# story: e08s01
# Dependency resolutions must avoid releases published within the last 30 days.
min-release-age=30

# Keep the JavaScript toolchain deterministic and compatible with the pinned runtime.
engine-strict=true
strict-peer-deps=true
package-lock=true
save-exact=true

# Do not execute third-party code while acquiring dependencies.
ignore-scripts=true
allow-directory=none
allow-file=none
allow-git=none
allow-remote=none

# Use one TLS-protected public registry and suppress automatic reporting endpoints.
registry=https://registry.npmjs.org/
strict-ssl=true
audit=false
fund=false
